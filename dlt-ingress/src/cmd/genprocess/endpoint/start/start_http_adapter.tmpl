func (e *Endpoint) Handle(c context.Context, req *api.HttpAdapterRequest[{{ .Name }}Request]) (*api.HttpAdapterResponse[modelprocess.BaseProcessModel], error) {
	userName, err := req.GetUserEmail()
	if err != nil {
		return nil, err
	}

	// TODO: Add params parsing from URL/body as needed

	response, err := e.service.Execute(c, start{{ ToLower .Name }}.Model{
		Email:       userName,
		CallbackUrl: req.Body.CallbackUrl,
		// TODO: Add additional model fields as needed
	})
	if err != nil {
		return nil, err
	}

	return api.NewHttpAdapterResponse(http.StatusAccepted, &modelprocess.BaseProcessModel{
		Id:     response.ProcessId,
		Status: response.Status,
		Type:   response.Type,
	}), nil
}
{{- else}}
func (e *Endpoint) {{ .Name }}(c *gin.Context) {
	userName, exists := c.Get("email")
	if !exists {
		c.JSON(401, gin.H{"error": "user not authenticated"})
		return
	}

	// TODO: Add params parsing from URL/body as needed
	var request {{ .Name }}Request
	if c.Request.Body != http.NoBody {
		if err := c.BindJSON(&request); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
			return
		}
	} else {
		request.CallbackUrl = ""
	}

	response, domainErr := e.service.Execute(c.Request.Context(), start{{ ToLower .Name }}.Model{
		Email:       userName.(string),
		CallbackUrl: request.CallbackUrl,
		// TODO: Add additional model fields as needed
	})
	if domainErr != nil {
		code := domainerrors.MapDomainErrorToHttp(domainErr)
		c.JSON(code, gin.H{"error": domainErr.Error(), "code": http.StatusText(code)})
		return
	}

	c.JSON(http.StatusAccepted, &modelprocess.BaseProcessModel{
		Id:     response.ProcessId,
		Status: response.Status,
		Type:   response.Type,
	})
}
