package {{ ToLower .Entity }}{{ ToLower (ToDone .Action) }}

import (
	"context"
	"dlt-ingress/src/main/{{ ToLower .BoundedContext }}/app/command/{{ .ExtraPath }}{{ ToLower .Entity }}/{{ ToLower .Action}}"
	"dlt-ingress/src/main/{{ ToLower .BoundedContext }}/domain/{{ .ExtraPath }}{{ ToLower .Entity }}"

	"gitlab.com/iobuilders/projects/eng/iob-core/iob-go-core/v4/src/main/core/command"
)

type Listener struct {
	commandBus command.Bus
}

func NewListener(commandBus command.Bus) *Listener {
	return &Listener{commandBus: commandBus}
}

func (l *Listener) Listen(ctx context.Context, event *{{ ToLower .Entity }}.{{ .DLTEventName }}DLTEvent) error {
	_, err := l.commandBus.Dispatch(ctx, &{{ ToLower .Name }}.Command{
		//ProcessId:      event.ProcessId,
		BlockTimestamp: event.BlockTimestamp,
	})
	return err
}
